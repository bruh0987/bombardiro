{
	"compilerOptions": {
		"lib": [
			"esnext",
			"dom",
			"dom.iterable",
            "deno.ns"
		],
		"strict": true,
		"jsx": "react-jsx",
		"jsxImportSource": "svelte"
	},
    "tasks": {
        "dev": "deno run -A --unstable-sloppy-imports npm:vite@^6.0.0 dev",
        "build": "deno run -A --unstable-sloppy-imports npm:vite@^6.0.0 build",
        "preview": "deno run -A --unstable-sloppy-imports npm:vite@^6.0.0 preview",
        "check": "deno run -A --unstable-sloppy-imports npm:svelte-check --tsconfig ./tsconfig.json"
    },
	"imports": {
		"$lib/": "./src/lib/",
        "$env/dynamic/private": "./src/lib/deno-mocks.ts",
        "$app/environment": "./src/lib/deno-mocks.ts",
        "ws": "npm:ws@^8.18.0",
        "@std/dotenv": "jsr:@std/dotenv@^0.225.2",
        "@deno/svelte-adapter": "npm:@deno/svelte-adapter@^0.1.1"
	},
	"nodeModulesDir": "auto"
}
