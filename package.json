		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
